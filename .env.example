# Optional environment variables used by the app

# Ollama for LLM replies / NLU
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b-instruct

# Vosk: path to the extracted model directory (e.g., /path/to/vosk-model-small-en-us-0.15)
VOSK_MODEL_PATH=

# Piper TTS (external binary + voice model)
# PIPER_BIN=piper            # if not in PATH, set full path
# PIPER_MODEL=/path/to/en_US-amy-medium.onnx
